#!/bin/bash
# QSD5.337: user/group scripts run one at a time (several Add User clicks in a row ran useradd/userdel in parallel and lost users);
# a nested call (UnixChangeGroup -> UnixChangeUser, UnixAddUser -> ...) inherits TS_USRLOCK and does not lock again
if [ -z "$TS_USRLOCK" ] && command -v flock >/dev/null 2>&1; then export TS_USRLOCK=1; exec flock -w 900 /tmp/topstor-users.lock "$0" "$@"; fi
echo $@ > /root/unixchangeuser
export ETCDCTL_API=3
cd /TopStor
leaderip=`echo $@ | awk '{print $1}'`;
username=`echo $@ | awk '{print $2}'`;
usergroups=`echo $@ | awk  '{print $3}' | sed 's/groups//g' `;
userreq=`echo $@  | awk '{print $4}'`;
# every user is always a member of Everyone (the front end does not show or send that group)
if [[ $username != 'NoUser' ]] && getent group Everyone >/dev/null;
then
	if [[ $usergroups == 'NoGroup' || -z $usergroups ]];
	then
		usergroups='Everyone'
	else
		echo ",$usergroups," | grep -q ',Everyone,' || usergroups=$usergroups',Everyone'
	fi
fi
ischange=`echo $@  | awk '{print $5}'`;
pullsync=`echo $@  | awk '{print $6}'`;
stablegrp=""
# QC 617: every group-record write below was a bare 'etcdput' with no check: a write that did not land (a failed or timed-out put on a
# busy node, nothing reported) silently dropped the user from the group record (leader etcd had q018u1,q018u3 without q018u2 after a
# multi-row submit).  putgrp writes the record and reads it back; while the user is not (add) or still is (del) a member it writes
# again (3 more times, 2 s apart).  Reads that fail ('' or _1) are retried and never trusted.
# QC 617 (fix15): etcdget.py prints 'not reachable' and '_1' when a read fails or times out; the record built from that string
# ('not/,q018u3/not') was written to the leader's etcd, and the read-back of putgrp took it for good.  getgrp returns a group record
# only when it has the shape of one (<gid>:<gid>:<home>/<size>/<users>/...), retrying the read (5 x 3 s); '' when it never does.
getgrp() {
 local r
 for t in 1 2 3 4 5; do
  r=`/pace/etcdget.py $etcd usersigroup/$1 | tail -1`
  echo "$r" | grep -qE '^[0-9]+:[0-9]+:[^/]*/[^/]*/[^/]*/' && { echo "$r"; return 0; }
  sleep 3
 done
 return 1
}
putgrp() {
 echo "$2" | grep -qE '^[0-9]+:[0-9]+:[^/]*/[^/]*/[^/]*/' || { echo "putgrp: refused to write a malformed record for $1: $2"; return 1; }
 /pace/etcdput.py $etcd usersigroup/$1 $2
 for try in 1 2 3; do
  chk=`getgrp $1` || { sleep 2; continue; }
  ismember=0
  echo "$chk" | awk -F'/' '{print $3}' | tr ',' '
' | grep -qxF -- "$username" && ismember=1
  [ "$3" = add ] && [ $ismember = 1 ] && return
  [ "$3" = del ] && [ $ismember = 0 ] && return
  sleep 2
  /pace/etcdput.py $etcd usersigroup/$1 $2
 done
}
privilege="Box_Users";
contrun=`./privthis.sh $privilege $userreq`;
if [[ $contrun == 'true' ]];
then
	docker exec etcdclient /TopStor/logqueue.py `basename "$0"` running $userreq 
	myhost=`docker exec etcdclient /TopStor/etcdgetlocal.py clusternode`
	myhostip=`docker exec etcdclient /TopStor/etcdgetlocal.py clusternodeip`
	leader=`docker exec etcdclient /TopStor/etcdgetlocal.py leader`
	echo $leader | grep $myhost
	if [ $? -eq 0 ];
	then
	 	etcd=$leaderip
	else
		etcd=$myhostip
	fi
 #if a change happens before a user is created, no need to proceed, the script will be run again in the AddUser
 id $username
 if [ $? -ne 0 ];
 then
	docker exec etcdclient /TopStor/logqueue.py `basename "$0"` finish $userreq 
	exit 
 fi
 echo 'NoUser' | grep $username
 if [ $? -ne 0 ];
 then
 	echo s$pullsync | grep pull 
 	if [ $? -ne 0 ];
 	then
  		docker exec etcdclient /TopStor/logmsg.py Unst1024 info $userreq $username
	fi
 fi
 echo $username | grep NoUser
 if [ $? -ne 0 ];
 then
  if [[ $usergroups == 'NoGroup' ]];
  then
   usermod -G '' $username
  else
   usermod -G '' $username
   usermod -G $usergroups $username
  fi
  usermod -a -G $username  $username
  cgrps=`/pace/etcdget.py $etcd usersigroup $username`
  cgrpsl=${#cgrps}
  while [ $cgrpsl  -gt 4 ];
  do
   l=`echo "${cgrps[@]}" | tail -1 `
   cgrps=`echo "${cgrps[@]}" | sed '$d'`
   cgrpsl=${#cgrps}
   cgrp=`echo $l | sed "s/('usersigroup\///g" | awk -F"'" '{print $1}' `  
   # QSD5.337: the etcd search returns every group whose value merely CONTAINS the name (qxb inside qxb1): only a group that lists this exact name counts
   echo `/pace/etcdget.py $etcd usersigroup/$cgrp` | awk -F'/' '{print $3}' | tr ',' '\n' | grep -qx -e "$username" || continue
   echo $usergroups | grep -w $cgrp  &>/dev/null
   if [ $? -ne 0 ];
   then
    usersall=`getgrp $cgrp` || { echo "group record $cgrp unreadable, not changed"; continue; }
    cusers=`echo $usersall | awk -F'/' '{print $3}'`
    cusersleft=`echo $usersall | cut -d/ -f1-2`
    cusersright=`echo $usersall | cut -d/ -f4-`
    # QSD5.337: exact member match (the unanchored sed also cut the name out of longer names: q015a out of q015a1)
    newusers=`echo ${cusers} | tr ',' '\n' | grep -vx -e "$username" -e '' | paste -sd, - `
    resusers=${#newusers}
    if [ $resusers -lt 1 ];
    then
     newusers='NoUser'
    fi
    newop=$cusersleft'/'$newusers'/'$cusersright
    groupres=${newop}
    echo to remove : $cgrp to be $groupres
 echo $etcd '333333333333333333333333333333333333333333333333333333333333333'
    putgrp $cgrp $groupres del
   else
    stablegrp=${stablegrp}${cgrp}',';
    echo to keep : $cgrp
   fi
  done
  echo the stable=$stablegrp
  usergroups=$usergroups','
  grpsl=` echo ${usergroups} | sed 's/,/ /g' | wc -w`
  while [ $grpsl -gt 0 ]; 
  do
   l=`echo $usergroups |  cut -d, -f 1`
   usergroups=`echo $usergroups | sed 's/ /,/g' | cut -d, -f2-`
   usergroups=$usergroups','
   grpsl=` echo ${usergroups} | sed 's/,/ /g' | wc -w`
   echo $l | grep -w $username
   if [ $? -eq 0 ];
   then
	continue
   fi
   echo usrgroups=$usergroups
   echo grpsl=$grpsl
   echo stablegrp=$stablegrp
   echo $l | grep -w NoGroup 
   if [ $? -ne 0 ];
   then
    echo 'kdsl' $stablegrp | grep -w $l 
    echo 'kdsl' $stablegrp | grep -w $l >/dev/null
    if [ $? -ne 0 ];
    then
     usersall=`getgrp $l` || { echo "group record $l unreadable, not changed"; continue; }
     cusers=`echo $usersall | awk -F'/' '{print $3}'`
     cusersleft=`echo $usersall | cut -d/ -f1-2`
     cusersright=`echo $usersall | cut -d/ -f4-`
     echo $cusers | grep -w NoUser
     if [ $? -ne 0 ];
     then
      newusers=${cusers}','$username
      newop=$cusersleft'/'$newusers'/'$cusersright
      groupres=`echo ${newop}`
      echo appending $l to be $groupres
      putgrp $l $groupres add
     else 
      echo I am here: $username
      newusers=$username
      newop=$cusersleft'/'$newusers'/'$cusersright
      groupres=`echo ${newop}`
      echo adding $l to be $groupres

      putgrp $l $groupres add
     fi
    fi
   fi
  done
######### or else username=NoUser.. Remove all users form this usergroups
 else
  allusers=`/pace/etcdget.py $etcd usersigroup/$usergroups`
  usersall=`echo $allusers | awk -F'/' '{print $3}'`','
  usersl=` echo ${usersall} | sed 's/,/ /g' | wc -w`
  while [ $usersl -gt 0 ]; 
  do
   l=`echo $usersall |  cut -d, -f 1`
   usersall=`echo $usersall | sed 's/ /,/g' | cut -d, -f2-`
   usersall=$usersall','
   usersl=`echo ${usersall} | sed 's/,/ /g' | wc -w`
   echo l=$l
   echo usersall=$usersall
   echo usersl=$usersl
   gpasswd -d $l $usergroups
  done
   cusers=`echo $allusers | awk -F'/' '{print $3}'`
   cusersleft=`echo $allusers | cut -d/ -f1-2`
   cusersright=`echo $allusers | cut -d/ -f4-`
   newusers='NoUser'
   newop=$cusersleft'/'$newusers'/'$cusersright
   groupres=`echo ${newop}`
   /pace/etcdput.py $etcd usersigroup/$usergroups  $groupres 
 fi
 #/TopStor/broadcast.py UserChange /TopStor/pump.sh UnixChangeUser_sync -d$myhost $@ 
 echo 'NoUser' | grep $username
 if [ $? -ne 0 ];
 then
	echo s$pullsync | grep pull 
 	if [ $? -ne 0 ];
 	then
  		docker exec etcdclient /TopStor/logmsg.py Unsu1024 info $userreq $username
	fi
 fi
 echo dddddddddddddddddddddddddd $leader, $myhost
 echo $leader | grep $myhost
 if [ $? -eq 0 ];
 then
	# QSD5.345: the value names the user and is in nanoseconds (10 s ahead, as before, so it is applied after the user
	# request).  It was UsrChange_<seconds>: two changes in the same second (UnixChangeGroup changes every member in a
	# row) had the SAME value; the followers track done requests by value and the leader prunes by value, so the second
	# change was taken as done / pruned before any follower ran it -- the follower missed the member (QC tests 638, 678).
	stamp=$(( `date +%s%N` + 10000000000 ))
	myscript=`basename "$0"`
	params=`echo $myscript $@ pull | sed 's\ \\_\g'`
	echo params=$params
	echo /pace/etcdput.py $etcd sync/UsrChange/$params/request/$myhost UsrChange_${username}_$stamp
	/TopStor/etcdput.py $etcd sync/UsrChange/$params/request/$myhost UsrChange_${username}_$stamp
	/TopStor/etcdput.py $etcd sync/UsrChange/$params/request UsrChange_${username}_$stamp
 fi
 docker exec etcdclient /TopStor/logqueue.py `basename "$0"` finish $userreq 
fi
