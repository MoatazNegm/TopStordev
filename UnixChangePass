#!/bin/sh
echo $@ > /root/usrchapass
export ETCDCTL_API=3

cd /TopStor
username=`echo $@ | awk '{print $1}'`;
pas=`docker exec etcdclient /TopStor/etcdgetlocal.py usershash/$username` 
userpass=`/TopStor/decthis.sh $username $pas | awk -F'_result' '{print $2}'`
userreq=`echo $@  | awk '{print $2}'`;
privilege="Box_Users";
contrun=`./privthis.sh $privilege $userreq`;
if [[ $contrun == 'true' ]]
then
	leaderip=`docker exec etcdclient /TopStor/etcdgetlocal.py leaderip`
	myhost=`docker exec etcdclient /TopStor/etcdgetlocal.py clusternode`
	myhostip=`docker exec etcdclient /TopStor/etcdgetlocal.py clusternodeip`
	leader=`docker exec etcdclient /TopStor/etcdgetlocal.py leader`
	docker exec etcdclient /TopStor/logqueue.py `basename "$0"` running $userreq
	echo $leader | grep $myhost
	if [ $? -ne 0 ];
	then
 		etcd=$myhostip
	else
 		etcd=$leaderip
 
	fi
	# QSD5.348: 'usermod -p' takes an ENCRYPTED value; it got the clear password, so every password change (each sync/passwd
	# request on every node: Hostconfig.py, usersyncall.py) wrote it back into /etc/shadow in clear text.
	# QSD5.349: every user, admin included, gets '!' (no unix password).  QSD5.348 gave admin a real SHA-512 hash, and
	# 'grep -w admin' also matched it-admin / admin-ops ('-' ends a word): those users got a working SSH password (nologin
	# does not stop 'ssh -N -L' to the node's etcd).  Nothing reads a unix password: the API checks usershash/<user>
	# in etcd, Grafana gets admin's password from it (promserver.sh), samba has its own database (smbuserfix.sh).  admin is special only by its EXACT name.
	usermod -p '!' $username
 	docker exec etcdclient /TopStor/etcdputlocal.py $myip 'usershash/'$username $pas 2>/dev/null
	if [ "$username" = admin ];
	then
 		usermod $username -c"AdminStor"$pas
		echo $etcd | grep $leaderip
		if [ $? -eq 0 ];
		then
			/TopStor/promserver.sh $leaderip
		fi
	else
		# QSD5.349: a user whose name only contains admin (it-admin) comes here too: its CIFS password is updated
 		usermod $username -c"TopStor"$pas
		currentcifs=`docker ps | egrep 'CIFS|HOM' | awk '{print $1}'`
		if [[ ! -z $currentcifs ]]
		then
 			echo "$currentcifs" | while read y; do docker exec $y  sh /hostetc/smbuserfix.sh x $username $userpass;  done; 
		fi
 
	fi
	# QSD5.348: usermod keeps the table as it was before in /etc/shadow- (an older clear field of any user), and
	# /opt/passwds/shadow (UnixAddGroup's hard link) can hold an older copy: shadowscrub.py cleans both, cheap when clean
	python3 /TopStor/shadowscrub.py >/dev/null 2>&1
	docker exec etcdclient /TopStor/logqueue.py `basename "$0"` finish $userreq
fi
