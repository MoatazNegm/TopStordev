#!/bin/sh
export ETCDCTL_API=3
cd /TopStor/
echo $@ > /root/volchange
leaderip=`echo $@ | awk '{print $1}'`;
name=`echo $@ | awk '{print $3}'`;
pDG=`echo $@ | awk '{print $2}'`;
quota=`echo $@ | awk '{print $4}'`;
writev=`echo $@ | awk '{print $5}'`;
ipaddr=`echo $@ | awk '{print $6}'`;
ipsubnet=`echo $@ | awk '{print $7}'`;
active=`echo $@ | awk '{print $8}'`;
myhost=`echo $@ | awk '{print $9}'`;
userreq=` echo $@ | awk '{print $10}'`;
domain=` echo $@ | awk '{print $11}'`;
domainsrvn=` echo $@ | awk '{print $12}'`;
domainsrvi=` echo $@ | awk '{print $13}'`;
domadm=` echo $@ | awk '{print $14}'`;
dompass=` echo $@ | awk '{print $15}'`;
DG=`echo $pDG `;
privilege="HOME";
contrun=`./privthis.sh $privilege $userreq`;
if [[ $contrun == 'true' ]]
then
        myhost=`docker exec etcdclient /TopStor/etcdgetlocal.py clusternode`
        myhostip=`docker exec etcdclient /TopStor/etcdgetlocal.py clusternodeip`
        leader=`docker exec etcdclient /TopStor/etcdgetlocal.py leader`
        echo $leader | grep $myhost
        if [ $? -ne 0 ];
        then
                etcd=$myhostip
        else
                etcd=$leaderip
        fi
 docker exec etcdclient /TopStor/logqueue.py `basename "$0"` running $userreq
 if [ $writev != 'nogroup' ];
 then
  writev=`echo $writev | sed 's/nogroup//g'`
 fi
 # QSD5.352 r8 (validator r7, statusmount): only 'active' and 'disabled' (the canonical off value, Volumeactivesh.sh,
 # targetcreatevol.sh) are written.  Any other word was written as it came: 'inactive' contains 'active', so this script
 # took the home down, VolumeCheck (getdirtyvols) found the registry 'active' and cifs.py served it again, every cycle; a
 # '/' broke the registry record and the sed below.  'active' in any case stays on, anything else is off = 'disabled'
 # (fapi volumes/config refuses other words from a request; this covers a stored value and other callers).
 case `echo "$active" | tr 'A-Z' 'a-z'` in
  active) active='active' ;;
  *) [ "$active" = 'disabled' ] || echo "statusmount '$active' written as disabled" >> /root/volchange; active='disabled' ;;
 esac
 echo $pDG $name $quota $writev $ipaddr $ipsubnet $myhost $userreq $extraparms>> /root/volchange
 docker exec etcdclient /TopStor/logmsg.py VolCst01 info $userreq $name
 echo name=$name
 myhost=`hostname -s`
 older=`ETCDCTL_API=3 /pace/etcdget.py $etcd volumes $name `
 echo $older | grep DOMAIN
 if [ $? -ne 0 ];
 then
  extraparms=''
 else
  isparams=`echo $domain | wc -c`
  if [ $isparams -ge 3 ];
  then
   extraparms='/'$domain'/'$domainsrvn'/'$domainsrvi'/'$domadm'/'$dompass
  else
    extraparms='/'`echo $older | awk -F'/' '{for(i=NF-4;i<=NF;i++) printf $i"/"; print ""}' | sed "s/')\///g"`
  fi
 fi
echo /pace/etcdput.py $leaderip volumes/HOMEE/$myhost/$DG/$name $DG/$name/no/yes/$writev/administrator/yes/$oldipaddr/${oldipsubnet}$extraparms/$active >> /root/volchange
 oldipaddr=`zfs get -H ip:addr $DG/$name | awk '{print $3}'`
 oldipsubnet=`zfs get -H ip:subnet $DG/$name | awk '{print $3}'`
 # QSD5.352 r6 (prover D1): this script called 'VolumefixChangeCIFS ... HOMEE <old ip>' first.  For a user with the HOMEE
 # privilege (admin) that ran cifsremove.sh, the DELETE path of a share: 'rm -rf /<pool>/smb.<home>' (also the vol/size
 # keys, and crondelete).  getvols.sh / VolumeCheck know a home only by the SUMMARY line of that file and cifs.py waits for
 # it, so after ANY home change (address, subnet, or volumes/config with the same address) the home was never served
 # again, and the anchored edit edited a missing file.  The share file is kept and rendered again now (r7); the old container and
 # the old address go through VolumeDockerChange.py only (QSD5.352, QC 706).  Order: the share file, the dataset
 # properties and the registry record carry the new address BEFORE the old container goes (a VolumeCheck run in between
 # starts the new address, not the old one), then the share is started on the new address here.
 validold=0
 if [ -n "$oldipaddr" ] && [ "$oldipaddr" != '-' ]; then validold=1; fi
 addrchange=0
 if [ $validold -eq 1 ] && { [ "$oldipaddr" != "$ipaddr" ] || [ "$oldipsubnet" != "$ipsubnet" ]; }; then addrchange=1; fi
 # QSD5.352 r7 (validator R2): the share file follows EVERY field of the change, not only the address: the groups (the
 # Home Folders page sends volumes/config with the groups and the same address) and the status (statusmount) were written
 # to the registry and the dataset but never to the SUMMARY line or 'write list', so the share kept the old groups, a
 # disable was reverted by VolumeCheck (SUMMARY active, registry disable) and a take-over wrote the old groups back.  The
 # file is rendered from the template every time, exactly as VolumeCreateHOME writes it (for a file written by
 # VolumeCreateHOME an address/subnet change differs in the SUMMARY line only, so the r2 anchored edit is not needed any
 # more), and installed (and the share restarted below) only when it differs from /<pool>/smb.<home>.  A missing file
 # (a home broken by the old flow) or one rewritten as 'HOME .../ACTIVE' (VolumeActivateHome on a follower) is repaired.
 shortname=`echo ${name} | rev | cut -d_ -f2- | rev`
 sed -e "s/Vtype/HOMEE/g" -e "s/Rpool/$DG/g" -e "s/Rname/$name/g" -e "s/Rreadv/no/g" -e "s/Rbrows/yes/g" \
     -e "s/Rwritev/$writev/g" -e "s/Radmin/administrator/g" -e "s/Rwritea/yes/g" -e "s/Ripadd/$ipaddr/g" \
     -e "s/Ripsub/$ipsubnet/g" -e "s/SHORTNAME/$shortname/g" -e "s/NAMECIFS/$name/g" -e "s/POOL/$DG/g" -e "s/Yes/yes/g" \
     -e "s/\@everyone/$writev/g" -e "s/IPADDRESS/$ipaddr/g" -e "s/IPSUBNET/$ipsubnet/g" -e "s/ACTIVE/$active/g" \
     /TopStor/sharecifs.txt > /TopStordata/smb.${name}.new
 regen=0
 if [ -s /TopStordata/smb.${name}.new ] && ! cmp -s /TopStordata/smb.${name}.new /$DG/smb.$name;
 then
  mv -f /TopStordata/smb.${name}.new /TopStordata/smb.${name}
  yes | cp /TopStordata/smb.$name /$DG/
  regen=1
  echo "share file /$DG/smb.$name written for $ipaddr/$ipsubnet groups $writev status $active" >> /root/volchange
 fi
 rm -f /TopStordata/smb.${name}.new
 /sbin/zfs set ip:addr=$ipaddr $DG/$name
 /sbin/zfs set ip:subnet=$ipsubnet $DG/$name
 /sbin/zfs set status:mount=$active $DG/$name
 ETCDCTL_API=3 /pace/etcddel.py $leaderip volumes $name
 echo ETCDCTL_API=3 /pace/etcdput.py $leaderip volumes/HOMEE/$myhost/$DG/$name $DG/$name/no/yes/$writev/administrator/yes/$ipaddr/${ipsubnet}$extraparms/$active
 ETCDCTL_API=3 /pace/etcdput.py $leaderip volumes/HOMEE/$myhost/$DG/$name $DG/$name/no/yes/$writev/administrator/yes/$ipaddr/${ipsubnet}$extraparms/$active
 stamp=`date +%s`
 ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/volumes/${DG}_$name/request volumes_$stamp
 ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/volumes/${DG}_$name/request/$leader volumes_$stamp
 echo checkkkkkkkkkkkkkkkkkkkkkkkkking
 ETCDCTL_API=3 /pace/etcdget.py $leaderip volumes $name
 # QSD5.352 (QC 706): the old HOMEE-<old ip> container and the old address go when the address or the subnet changes
 # (VolumeDockerChange.py '<old ip> <old subnet> <type> <dataset>'; the address stays while another dataset uses it)
 if [ $addrchange -eq 1 ];
 then
  /TopStor/VolumeDockerChange.py $oldipaddr ${oldipsubnet:-24} HOMEE $DG/$name
  # r8 (validator r7, point 3): HOMEE-<old ip> served every home of the old address; another ACTIVE home of this node
  # still there is started again now (cifs.py, records from the leader: this home's record already has the new
  # address), not one VolumeCheck cycle (~60 s) later
  if [ "$oldipaddr" != "$ipaddr" ]; then
   other=`/TopStor/getvols.sh home | grep -vF "$DG/$name/" | grep -F "/$oldipaddr/" | grep '/active$' | head -n 1`
   if [ -n "$other" ]; then
    opool=`echo $other | cut -d/ -f1`; oname=`echo $other | cut -d/ -f2`; osub=`echo $other | cut -d/ -f9`
    echo "home $opool/$oname still on $oldipaddr: share restarted" >> /root/volchange
    /TopStor/cifs.py $leader $leaderip $myhost $myhostip $leaderip $opool $oname $oldipaddr ${osub:-24} HOMEE
   fi
  fi
 fi
 # r7 (validator R2): a disabled home is served no more.  cifs.py leaves a disabled record out but does not stop a
 # running container, so HOMEE-<ip> (and the address, unless another dataset uses it) goes when no other ACTIVE home of
 # this node is on the address; otherwise cifs.py below starts the share again without this home.
 offnow=0
 if [ "$active" != 'active' ] && ! /TopStor/getvols.sh home | grep -vF "$DG/$name/" | grep -F "/$ipaddr/" | grep -q '/active$';
 then
  /TopStor/VolumeDockerChange.py $ipaddr ${ipsubnet:-24} HOMEE $DG/$name
  offnow=1
 fi
 # r6: the share is started on the new address now (as VolumeCreateHOME does; cifs.py takes the per-address lock, a
 # VolumeCheck run for the same address waits for it); an old-address container that a VolumeCheck run started in the
 # meantime is removed again when no home of this node uses the old address any more
 if [ $offnow -eq 0 ] && { [ $addrchange -eq 1 ] || [ $regen -eq 1 ]; };
 then
  # r8 (validator r7 N2): cifs.py reads the homes of the address from the LEADER's etcd, where the record was just
  # written.  On a follower $etcd is its own copy, refreshed by the sync loop seconds later: a home disabled on an address
  # shared with another home was still 'active' there and the share was restarted WITH it (nothing corrected that:
  # VolumeCheck checks only active homes); an address change or an enable waited a VolumeCheck cycle.
  /TopStor/cifs.py $leader $leaderip $myhost $myhostip $leaderip $DG $name $ipaddr $ipsubnet HOMEE
 fi
 if [ $validold -eq 1 ] && [ "$oldipaddr" != "$ipaddr" ] && docker ps --format '{{.Names}}' | grep -qFx "HOMEE-$oldipaddr";
 then
  /TopStor/getvols.sh home | grep -qF "/$oldipaddr/" || /TopStor/VolumeDockerChange.py $oldipaddr ${oldipsubnet:-24} HOMEE $DG/$name
 fi


 #/pace/broadcasttolocal.py volumes/HOME/$myhost/$DG/$name $DG/$name/no/yes/$writev/administrator/yes/$ipaddr/$ipsubnet
 # QSD5.352 r7 (validator R1): 'VolumeActivateHome vol=<home> user=<user>' was called here.  It is a no-op only on the
 # LEADER (it takes 'vol=<home>' as the leader address, the lookup fails and it exits).  On a FOLLOWER it reads its local
 # etcd, finds the home and rewrites /<pool>/smb.<home> with type 'HOME' and the status 'ACTIVE' (never replaced); one
 # VolumeCheck pass then took the home as dirty, removed the HOMEE-<ip> container just started and wrote '/ACTIVE' into
 # the registry, which cifs.py ignores: the home stayed down.  This script writes the share file, the registry record and
 # starts the share itself (above), so the call is gone.
 /pace/putzpool.py
 /TopStor/logmsg.py VolCsu01 info $userreq $name
 echo ready ;
 docker exec etcdclient /TopStor/logqueue.py `basename "$0"` finish $userreq
fi
