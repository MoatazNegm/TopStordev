#!/bin/sh
export ETCDCTL_API=3
cd /TopStor/
echo $@ > ~/tmp
leader=`echo $@ | awk '{print $1}'`
leaderip=`echo $@ | awk '{print $2}'`
myhost=`echo $@ | awk '{print $3}'`
myip=`echo $@ | awk '{print $4}'`
dev='enp0s8'
txtres='/TopStordata/'`basename $0`'.txt'
# test 672 (QX-073) step 1: the zone the user chose is tz/<leader> in the CLUSTER etcd. A follower read it from its own local
# etcd ($myip), where the key is never copied: it got '_1', no zone matched and it fell back to Kuwait (and wrote that back as
# its own tz). Read the cluster etcd, as HostManualconfigNTP and HostManualconfigDNS do.
echo ./etcdget.py $leaderip tz/$leader
fulltz=`./etcdget.py $leaderip tz/$leader` 
echo fulltz = $fulltz
echo $leader | grep -q $myhost
if [ $? -ne 0 ] && { [ -z "$fulltz" ] || echo "$fulltz" | grep -q '^_1' ; }
then
 # a follower without the leader's zone keeps its own zone and does not report one back (no silent Kuwait)
 echo "HostManualconfigTZ: no tz/$leader in the cluster etcd, $myhost keeps its time zone"
 exit 1
fi
tz=`echo $fulltz | awk -F'%' '{print $1}' `
echo tz=$tz
tzone=`timedatectl list-timezones | grep $tz | head -1` 
echo tzone=$tzone
echo timedatectl set-timezone $tzone
timedatectl set-timezone $tzone
ctz=`timedatectl | grep zone | awk -F'zone:' '{print $2}' | awk '{print $1}'`
echo ctz=$ctz  tzone=$tzone etcdtz=$tz
echo $tzone | grep $ctz
if [ $? -ne 0 ];
then 
 echo init
 fulltz='Kuw%(GMT+03!00)_Moscow^_St._Petersburg^_Volgograd'
 tz=`echo $fulltz | awk -F'%' '{print $1}' `
 tzone=`timedatectl list-timezones | grep $tz` 
fi
echo $tz, $tzone
echo timedatectl set-timezone $tzone
timedatectl set-timezone $tzone
echo $leader | grep $myhost
if [ $? -ne 0 ];
then
	./etcdput.py $leaderip tz/$myhost $fulltz 
	stamp=`date +%s`
  	./etcdput.py $leaderip sync/teezee/_____/request teezee_$stamp
  	./etcdput.py $leaderip sync/teezee/_____/request/$leader teezee_$stamp

fi
