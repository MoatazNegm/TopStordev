#!/bin/sh
export ETCDCTL_API=3
cd /TopStor/
echo $@ > /root/tmp
leaderip=` echo $@ | awk '{print $1}'`;
pool=` echo $@ | awk '{print $2}'`;
userreq=` echo $@ | awk '{print $3}'`;
privilege="DiskGroups";
# QSD5.346: 'zpool import <name>' refuses when more than one exported pool carries the name ("more than one matching
# pool", "import by numeric ID instead"): a stale copy of the pool (a mirror leg that was away, an older pool on reused
# disks) is listed next to it.  The destroy then never ran, the pool stayed exported with no tombstone and came back when
# the other node returned (QSD5.345 proof).  importpool <pool> [<guid>]: by name; on that refusal by numeric id -- the
# guid the pool had here before the export when it is known, else the copies of that name in the order ONLINE first.
# Never '-f': a copy that is in use on another system is not taken.
importpool() {
 /sbin/zpool import $1 2>/root/dgdestroyerror && return 0
 grep -q 'more than one matching pool' /root/dgdestroyerror || return 1
 cands=`/sbin/zpool import 2>/dev/null | awk -v p="$1" '$1=="pool:" { n=$2; id="" } $1=="id:" && n==p { id=$2 } $1=="state:" && id!="" { print id, $2; id="" }'`
 ids=''
 [ -n "$2" ] && echo "$cands" | awk '{print $1}' | grep -qx -- "$2" && ids="$2"
 ids="$ids `echo "$cands" | awk '$2=="ONLINE" {print $1}'` `echo "$cands" | awk '$2!="ONLINE" {print $1}'`"
 echo "zpool import $1 ambiguous (guid here: ${2:-unknown}), copies: `echo $cands`" >> /root/dgdestroyretry
 for id in $ids; do
  /sbin/zpool import $id 2>>/root/dgdestroyerror && { echo "zpool import $1 by id $id" >> /root/dgdestroyretry; return 0; }
 done
 return 1
}
echo hi=$privilege > /root/tmp2
contrun=`./privthis.sh $privilege $userreq`;
echo hi=$contrun >> /root/tmp2
# QSD5.346: without the privilege nothing happens.  The 'if' below closes before the export / import / destroy part, so
# that part (and now the tombstone) ran also for a user without DiskGroups ('pools/delpool' does not check it itself).
echo $contrun | grep -q 'true' || { echo "no privilege $privilege for $userreq" >> /root/tmp2; docker exec etcdclient /TopStor/logmsg.py Priv1004 error system $userreq; exit; }
echo $contrun | grep 'true'
if [ $? -eq 0  ]
then
	myhost=`docker exec etcdclient /TopStor/etcdgetlocal.py clusternode`
	myhostip=`docker exec etcdclient /TopStor/etcdgetlocal.py clusternodeip`
	leader=`docker exec etcdclient /TopStor/etcdgetlocal.py leader`
echo iam in >> /root/tmp2
 waiting=1
 waitingc=1
 while [ $waiting -eq 1 ];
 do
  echo to frst while >> /root/tmp2
  currentreq=`/pace/etcdget.py $leaderip requests/DGdestroypool --prefix`'currentreq'
  echo currentre=$currentreq  >> /root/tmp2
  echo $currentreq | grep $myhost
  if [ $? -ne 0 ];
  then
  echo to continue >> /root/tmp2
   break
  fi
  echo to continue 0 >> /root/tmp2
  waitingc=$((waitingc+1))
  echo to continue 1, $waitingc >> /root/tmp2
  if [ $waitingc -eq 20 ];
  then
   echo to continue 2 >> /root/tmp2
   break
  fi
   echo to continue 3 >> /root/tmp2
  sleep 1
 done
 echo Iam her2 >> /root/tmp2
 zpool status | grep $pool 
 if [ $? -ne 0 ];
 then
  # the pool is listed but exported (partner stop/return, failed take-over): import it here so it is really destroyed;
  # a silent exit left the pool behind and a node re-imported it later, stealing disks of a new pool (QSD5.314)
  udevadm settle 2>/dev/null
  importpool $pool
  zpool status | grep $pool
  if [ $? -ne 0 ];
  then
   echo "zpool import $pool before destroy failed: `cat /root/dgdestroyerror`" >> /root/dgdestroyretry
   docker exec etcdclient /TopStor/logmsg.py DGfa5 error $userreq $pool
   # QSD5.346: no silent exit -- the tombstone and the poolnxt/ActPool clean-up below are written also when the pool
   # cannot be taken here, so no node's import loop brings the deleted pool back later
   skipdestroy=1
  fi
 fi
 if [ -z "$skipdestroy" ]; then
 /pace/etcdput.py $leaderip requests/DGdestroypool/$myhost $myhost/$userreq
 # marker for the standby's import loop (zpooltoimport.py): the pool is exported for a moment below and must not be imported by
 # the other node then (it did, 7 s after the delete started: the destroy ended 'pool is busy' and the owner changed; QC test 10, QSD5.334)
 /pace/etcdput.py $leaderip destroying/$pool $myhost
 docker exec etcdclient /TopStor/logqueue.py `basename "$0"` running $userreq 
 docker exec etcdclient /TopStor/logmsg.py DGst5 info $userreq $pool
  stamp=`date +%s`
  ETCDCTL_API=3 /pace/etcddel.py $leaderip ActPool/$pool 
  ETCDCTL_API=3 /pace/etcddel.py $leaderip sync/ActPool/ ${pool} 
  # QSD5.345: the etcdonly delete template is Del_<prefix>_<text> (checksyncs.py: dels(<own etcd>, prefix, text)).  It was
  # Del_<pool>_$guid ($guid is not set here): the followers deleted nothing and kept ActPool/<pool> in their own etcd, which
  # becomes the cluster etcd when such a node takes the leadership -- and a pool name in ActPool/ is what lets the import
  # loop take an exported copy of the pool again (stale pool revived after delete, QC tests 13, 17)
  ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/ActPool/Del_ActPool_${pool}/request actpools_$stamp 
  ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/ActPool/Del_ActPool_${pool}/request/$leader actpools_$stamp 
  ETCDCTL_API=3 /pace/etcddel.py $leaderip pools $pool
  ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/pools/Del_pools_${pool}/request pools_$stamp 
  ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/pools/Del_pools_${pool}/request/$leader pools_$stamp
  #ETCDCTL_API=3 /TopStor/deltolocal.py pools $pool
  ETCDCTL_API=3 /pace/etcddel.py $leaderip fixpool/$pool
  ETCDCTL_API=3 /pace/etcddel.py $leaderip activepool/$pool 
  ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/activepool/Del_activepool::${pool}_--prefix/request activepool_$stamp 
  ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/activepool/Del_activepool::${pool}_--prefix/request/$leader activepool_$stamp 
  #ETCDCTL_API=3 /TopStor/deltolocal.py activepool/$pool activepool
  pkill $pool
  # QSD5.347: only the snapshot schedules of THIS pool leave the table.  'grep -v Snap' dropped every schedule line of the
  # node, also those of the other pools, until a later Snapperiod sync rewrote the table (QX-284 step 3).  A schedule line
  # names its volume as <pool>/<volume> (Snapshotnowhost::<pool>/<vol>::..., ...trend::<pool>/<vol>::..., the replication
  # 'pump.sh RemoteSnapshotnowOnce <host> <name> <pool>/<vol>'): a line that has 'Snap' and the pool name followed by '/'
  # and not preceded by a name character goes (pdhcp12/ does not match pdhcp123/ or ppdhcp12/).  The schedule records
  # Snapperiod/<period>/<pool>/... go too, with a Snapperiod sync, so etctocron on the other nodes drops their lines
  # instead of writing them back (and this node's next etctocron does not restore them either).
  # QSD5.348: the records go FIRST and the sync request is NOT acknowledged for this node; the table is filtered last.
  # QSD5.347 filtered the table first and marked this node done: an etctocron of this node in that second (another
  # Snapperiod sync) read the records still there and wrote the pool's lines back, and nothing ran etctocron here again.
  # Now any etctocron that starts after the delete writes the table without the pool, and this node runs one more itself
  # (synckeys + etctocron for the request).  The table is read, filtered and installed under a lock
  # (/TopStordata/cronfile.lock: two pool deletes at once on this node installed each other's old table, one pool's lines
  # came back) in private temp files (mktemp; the fixed /TopStordata/cronfile and cronfile.before were shared).
  ETCDCTL_API=3 /pace/etcdget.py $leaderip Snapperiod --prefix 2>/dev/null | grep -q "/$pool/"
  if [ $? -eq 0 ]; then
   ETCDCTL_API=3 /pace/etcddel.py $leaderip Snapperiod "/$pool/"
   # every node, this one and the leader too, runs synckeys + etctocron
   sstamp=`date +%s%N`
   ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/Snapperiod/DGdestroy_${pool}/request Snapperiod_${pool}_$sstamp
  fi
  crondir=`mktemp -d /TopStordata/cronfile.XXXXXX 2>/dev/null`
  if [ -n "$crondir" ] && [ -d "$crondir" ]; then
  (
   flock -w 60 9 || echo "pool $pool deleted: crontab lock not taken in 60 s, table filtered without it" >> /root/dgdestroyretry
   crontab -l > $crondir/before 2>/dev/null
   awk -v p="$pool/" '
    function haspool(s,   i, c) {
     while ((i = index(s, p)) > 0) {
      c = (i > 1) ? substr(s, i - 1, 1) : ""
      if (c !~ /[A-Za-z0-9_.-]/) return 1
      s = substr(s, i + 1)
     }
     return 0
    }
    !(/Snap/ && haspool($0))' $crondir/before > $crondir/after
   if ! cmp -s $crondir/before $crondir/after; then
    echo "pool $pool deleted: `diff $crondir/before $crondir/after | grep -c '^<'` snapshot schedule line(s) of it removed from the crontab" >> /root/dgdestroyretry
    crontab $crondir/after
   fi
  ) 9>/TopStordata/cronfile.lock
  rm -rf "$crondir"
  else
   echo "pool $pool deleted: no temp dir for the crontab (mktemp), its schedule lines stay until the Snapperiod sync" >> /root/dgdestroyretry
  fi
  ETCDCTL_API=3 /pace/etcddel.py $leaderip balance $pool
  ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/balancedtype/Del_balance_${pool}/request balancedtype_$stamp 
  ETCDCTL_API=3 /pace/etcdput.py s$leaderip ync/balancedtype/Del_balance_${pool}/request/$leader balancedtype_$stamp 
  ETCDCTL_API=3 /pace/etcddel.py $leaderip vol $pool
  ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/volumes/all/request volumes_$stamp 
  ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/volumes/all/request/$leader volumes_$stamp 

  echo > /etc/exports
 fi   # skipdestroy
 fi
 echo iam here2 >> /root/tmp2
 # container flavour: the pool is exported for a moment below; the standby node of poolnxt/<pool> imports a pool that is
 # unknown to it at once, reguids it and takes the ownership (zfs2 did it 3 s after the delete of QC test 10, QSD5.325), and
 # the destroy then ends 'pool is busy' with both nodes replacing disks.  Withdraw the assignment first.
 stamp=`date +%s`
 ETCDCTL_API=3 /pace/etcddel.py $leaderip poolnxt/$pool
 ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/poolnxt/Del_poolnxt_${pool}/request poolnxt_$stamp
 ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/poolnxt/Del_poolnxt_${pool}/request/$leader poolnxt_$stamp
 destroyrc=1
 if [ -z "$skipdestroy" ]; then
 sleep 2
 # QSD5.346: the pool's own guid, so the import below takes this pool and not a stale copy of the same name
 poolguid=`/sbin/zpool get -H -o value guid $pool 2>/dev/null`
 /sbin/zpool export -f $pool
 sleep 1
 # the import right after the export sometimes finds no pool ("cannot import: no such pool available") while the
 # devices are rescanned: the destroy then failed, the pool stayed exported and a node re-imported it later (QSD5.286)
 imptry=0
 while :; do
  importpool $pool $poolguid && break
  imptry=$((imptry+1))
  echo "zpool import $pool retry $imptry: `cat /root/dgdestroyerror`" >> /root/dgdestroyretry
  [ $imptry -ge 10 ] && break
  udevadm settle 2>/dev/null
  sleep 3
 done
 sleep 1
 /sbin/zpool destroy -f $pool 2>/root/dgdestroyerror
 destroyrc=$?
 fi   # skipdestroy
 if [ $destroyrc -ne 0 ]; then
   docker exec etcdclient /TopStor/logmsg.py DGfa5 error $userreq $pool
   echo "zpool destroy $pool failed: `cat /root/dgdestroyerror`" >> /root/dgdestroyretry
 else
   docker exec etcdclient /TopStor/logmsg.py DGsu5 info $userreq $pool 
 fi
 # QSD5.346: the clean-up and the tombstone follow the delete REQUEST, not only a successful destroy: a failed destroy
 # (ambiguous or failed import) left poolnxt/<pool> and no tombstone, and the exported pool was imported again when the
 # other node returned (QSD5.345 proof).  The user asked for the pool to go; 'DGsetPool import' clears the tombstone.
 {
   # the pool is gone: whatever a node's import loop wrote for it meanwhile (poolnxt/pools, also the doubled-p variants seen in
   # QC test 10) must not survive; a node importing the stale name held the disks of the next pool 'in use' (QSD5.326)
   stamp=`date +%s`
   for stale in $pool p$pool; do
    ETCDCTL_API=3 /pace/etcddel.py $leaderip poolnxt/$stale
    ETCDCTL_API=3 /pace/etcddel.py $leaderip pools/$stale
   done
   # QSD5.345: a mirror leg that was away (its node stopped, the leg detached meanwhile) still carries the pool's name and an
   # older state of it; it is listed by 'zpool import' when its node is back.  ActPool/<pool> again (the import loop's
   # reguid retry may have written it while this script ran) and a tombstone destroyedpool/<pool>, copied to every node
   # (etcdonly sync), so the import loop never assigns or imports a pool of that name again (zpooltoimport.py).  The pool
   # came back with its deleted volumes within minutes (QC test 17: pdhcp237243945 with dom16; test 13 after a node return).
   ETCDCTL_API=3 /pace/etcddel.py $leaderip ActPool/$pool
   nstamp=`date +%s%N`
   ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/ActPool/Del_ActPool_${pool}/request actpools_${pool}_$nstamp
   ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/ActPool/Del_ActPool_${pool}/request/$leader actpools_${pool}_$nstamp
   ETCDCTL_API=3 /pace/etcdput.py $leaderip destroyedpool/$pool $stamp
   ETCDCTL_API=3 /pace/etcddel.py $leaderip sync/destroyedpool/ ${pool}
   nstamp=`date +%s%N`     # the request value names the pool and is unique (same-second values are pruned together)
   ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/destroyedpool/Add_${pool}_$stamp/request destroyedpool_${pool}_$nstamp
   ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/destroyedpool/Add_${pool}_$stamp/request/$leader destroyedpool_${pool}_$nstamp
   ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/poolnxt/Del_poolnxt_${pool}/request poolnxt_$stamp
   ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/poolnxt/Del_poolnxt_${pool}/request/$leader poolnxt_$stamp
   ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/pools/Del_pools_${pool}/request pools_$stamp
   ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/pools/Del_pools_${pool}/request/$leader pools_$stamp
 }
/pace/etcddel.py $leaderip destroying/$pool
/pace/etcddel.py $leaderip requests/DGdestroypool/$myhost $myhost/$userreq
#systemctl restart zfs-zed
 docker exec etcdclient /TopStor/logqueue.py `basename "$0"` stop $userreq 
/pace/putzpool.py $leaderip
