#!/bin/sh
export ETCDCTL_API=3
cd /TopStor/
# QSD5.340 (test 650 QX-051 step 4): fapi volumes/config sends
#   <leaderip> <pool> <name> <quota> <ipaddr> <subnet> <portalport> <initiators> <chapuser> <chappas> <statusmount> <user> <owner> <user>
# (leaderip first, as VolumeChangeNFS/CIFS/HOME). The script read it without the leaderip slot (pDG=$1 was the leader address,
# userreq=$11 was the statusmount 'active'), privthis.sh refused 'active' and nothing was changed, with no message at all.
# The trace has the CHAP secret masked.
echo $@ | awk '{ if (NF >= 10) $10 = "***"; print }' > /root/volchange
leaderip=`echo $@ | awk '{print $1}'`;
pDG=`echo $@ | awk '{print $2}'`;
name=`echo $@ | awk '{print $3}'`;
quota=`echo $@ | awk '{print $4}'`;
ipaddr=`echo $@ | awk '{print $5}'`;
ipsubnet=`echo $@ | awk '{print $6}'`;
portalport=`echo $@ | awk '{print $7}'`;
initiators=`echo $@ | awk '{print $8}'`;
chapuser=`echo $@ | awk '{print $9}'`;
chappas=`echo $@ | awk '{print $10}'`;
active=`echo $@ | awk '{print $11}'`;
userreq=`echo $@ | awk '{print $12}'`;
DG=`echo $pDG `;
myhost=`hostname -s`;
nolun='This_lun_is_not_mapped'
logmsg() { docker exec etcdclient /TopStor/logmsg.py "$@"; }
# a refused or failed change is reported (VolCfa02, error) and stops before VolCsu01; the API reply does not wait for this script
fail() {
 echo "VolumeChangeISCSI $name: failed at $1"
 logmsg VolCfa02 error ${userreq:-system} ${name:-volume} $1
 exit 1
}
privilege="ISCSI";
contrun=`./privthis.sh $privilege $userreq`;
if [[ $contrun != 'true' ]]
then
 fail privilege
fi
logmsg VolCst01 info $userreq $name
echo "$ipaddr" | grep -Eq '^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$' || fail ipaddress
echo "$portalport" | grep -Eq '^[0-9]{1,5}$' || fail portalport
[ -n "$DG" -a -n "$name" -a -n "$active" ] || fail arguments
# the requested initiators: a comma list of iqn./eui./naa. names; This_lun_is_not_mapped (what the UI sends for an empty list)
# means none. LIO keeps node ACL names in lower case, the comparison below is done in lower case.
wanted=''
for i in `echo "$initiators" | sed 's/,/ /g'`
do
 [ "$i" = "$nolun" ] && continue
 echo "$i" | grep -Eiq '^(iqn\.[0-9]{4}-[0-9]{2}\.[^ ,/]+|eui\.[0-9a-f]{16}|naa\.[0-9a-f]{16,32})$' || fail initiator_$i
 i=`echo $i | tr 'A-Z' 'a-z'`
 echo " $wanted " | grep -q " $i " || wanted="$wanted $i"
done
wanted=`echo $wanted`
if [ -z "$wanted" ];
then
 initiators=$nolun
else
 initiators=`echo $wanted | sed 's/ /,/g'`
fi
# container flavour: no udev, the zvol node and its /dev/zvol link are made here (as addzfsvolumeastarget.sh)
[ -f /TopStor/flavor.sh ] && . /TopStor/flavor.sh
is_container 2>/dev/null && /pace/czvoldev.sh
disk=`ls -l /dev/zvol/$DG/$name 2>/dev/null | awk -F'/' '{print $NF}'`
[ -n "$disk" ] || fail zvol
diskids=$disk'-'$myhost'-'$name

# the LIO tree of a target's tpg1 as lines: A <acl> | M <acl> <mapped_lun> <backstore> | L <lun> <backstore> | P <ip:port>
tpgtree() {
 targetcli ls /iscsi/$1/tpg1 2>/dev/null | awk '
  { nm = ""; bs = ""
    for (i = 1; i < NF; i++) if ($i == "o-") { nm = $(i+1); break }
    for (i = 1; i <= NF; i++) if ($i ~ /block\//) { bs = $i; sub(/.*block\//, "", bs) }
    if (nm == "" || nm == "tpg1") next
    if (nm == "acls") { sec = "a"; next }
    if (nm == "luns") { sec = "l"; next }
    if (nm == "portals") { sec = "p"; next }
    if (sec == "a") { if (nm ~ /^mapped_lun[0-9]+$/) print "M", acl, nm, bs; else { acl = nm; print "A", acl } }
    else if (sec == "l") print "L", nm, bs
    else if (sec == "p") print "P", nm }'
}

# 1. an address change: the volume leaves the target of the old address (its LUN and the mapped LUNs of it are deleted); a
#    target left without a LUN is deleted with its address, as VolumeDeleteISCSI does
oldipaddr=`/sbin/zfs get -H -o value ip:addr $DG/$name 2>/dev/null`
oldipsubnet=`/sbin/zfs get -H -o value ip:subnet $DG/$name 2>/dev/null`
if echo "$oldipaddr" | grep -Eq '^[0-9.]+$' && [ "$oldipaddr" != "$ipaddr" ];
then
 oldT=iqn.2016-03.com.`echo $oldipaddr | sed 's/\.//g'`:data
 for lun in `tpgtree $oldT | awk -v b="$diskids" '$1=="L" && $3==b {print $2}'`
 do
  targetcli /iscsi/$oldT/tpg1/luns delete $lun
 done
 oldtree=`tpgtree $oldT`
 for acl in `echo "$oldtree" | awk '$1=="A" {print $2}'`
 do
  echo "$oldtree" | awk -v a="$acl" '$1=="M" && $2==a' | grep -q . || targetcli /iscsi/$oldT/tpg1/acls delete $acl
 done
 if [ -n "$oldtree" ] && ! echo "$oldtree" | grep -q '^L ';
 then
  targetcli /iscsi delete $oldT
  /TopStor/shareaddr.sh del $oldipaddr ${oldipsubnet:-24}
 fi
 # the old target keeps asking CHAP only while an ACL left on it has CHAP (QSD5.341)
 targetcli ls /iscsi/$oldT >/dev/null 2>&1 && /pace/iscsichap.sh $oldT nochap nochap
 /TopStor/shareaddr.sh add $ipaddr $ipsubnet
fi

# 2. the target of the address with the volume's LUN: made by addzfsvolumeastarget.sh when missing (new address, or a LUN
#    lost); an existing LUN is kept as it is (same LUN number, no break of the sessions of the initiators that stay). The old
#    code deleted the backstore (delzfsvolumetarget) and made everything again: every session lost the LUN for a while.
T=iqn.2016-03.com.`echo $ipaddr | sed 's/\.//g'`:data
lun=`tpgtree $T | awk -v b="$diskids" '$1=="L" && $3==b {print $2; exit}'`
if [ -z "$lun" ];
then
 first=`echo $wanted | awk '{print $1}'`
 /pace/addzfsvolumeastarget.sh $DG $name $ipaddr $portalport ${first:-$nolun} $chapuser $chappas
 lun=`tpgtree $T | awk -v b="$diskids" '$1=="L" && $3==b {print $2; exit}'`
 [ -n "$lun" ] || fail target_lun
fi

# 3. the node ACLs of the target follow the list for this LUN: a requested initiator gets an ACL with a mapped LUN of it (the
#    lowest free mapped_lun number, 0 for a new ACL); an initiator taken off loses its mapped LUN of this volume, and its whole
#    ACL when nothing else is mapped to it. Deleting the node ACL ends the initiator's open sessions in LIO and a later login is
#    refused (no-gen-acls); an ACL that still maps LUNs of other volumes keeps its session for those, without this LUN.
tree=`tpgtree $T`
for i in $wanted
do
 echo "$tree" | awk -v a="$i" '$1=="A" && $2==a' | grep -q . || targetcli /iscsi/$T/tpg1/acls create $i
 if ! echo "$tree" | awk -v a="$i" -v b="$diskids" '$1=="M" && $2==a && $4==b' | grep -q .;
 then
  used=`echo "$tree" | awk -v a="$i" '$1=="M" && $2==a {sub("mapped_lun", "", $3); print $3}'`
  n=0
  while echo "$used" | grep -qx $n; do n=$((n+1)); done
  targetcli /iscsi/$T/tpg1/acls/$i create mapped_lun=$n tpg_lun_or_backstore=/backstores/block/$diskids write_protect=0
 fi
done
for acl in `echo "$tree" | awk '$1=="A" {print $2}'`
do
 echo " $wanted " | grep -q " $acl " && continue
 mine=`echo "$tree" | awk -v a="$acl" -v b="$diskids" '$1=="M" && $2==a && $4==b {sub("mapped_lun", "", $3); print $3}'`
 others=`echo "$tree" | awk -v a="$acl" -v b="$diskids" '$1=="M" && $2==a && $4!=b' | grep -c .`
 if [ $others -eq 0 ];
 then
  # nothing else mapped (or an empty ACL left behind by an older change): the ACL goes, LIO closes its sessions
  targetcli /iscsi/$T/tpg1/acls delete $acl
 else
  for m in $mine; do targetcli /iscsi/$T/tpg1/acls/$acl delete $m; done
 fi
done

# 4. the portal of the target is <ipaddr>:<portalport>; another portal of it is kept only while another iSCSI volume of the
#    same address is recorded with that port
want=$ipaddr:$portalport
echo "$tree" | awk -v p="$want" '$1=="P" && $2==p' | grep -q . || targetcli /iscsi/$T/tpg1/portals create $ipaddr $portalport
keep=`/pace/etcdget.py $leaderip volumes/ISCSI "/$ipaddr/" 2>/dev/null | grep "^('volumes/ISCSI/" | awk -F"'" '{print $4}' | awk -F'/' -v n="$name" '$2!=n {print $3":"$5}'`
for p in `echo "$tree" | awk '$1=="P" {print $2}'`
do
 [ "$p" = "$want" ] && continue
 echo "$keep" | grep -qx "$p" && continue
 targetcli /iscsi/$T/tpg1/portals delete `echo $p | sed 's/:\([0-9]*\)$/ \1/'`
done
# 4b. CHAP (QSD5.341, test 653 QX-054 step 5): the volume's CHAP on the ACL of every requested initiator (a new chappas
#     replaces the old one: the new secret logs in, the old one is refused), clearchap removes it, nochap leaves the ACLs as
#     they are; the TPG asks CHAP (authentication=1) while an ACL of it has a CHAP user
/pace/iscsichap.sh $T "$chapuser" "$chappas" $wanted || fail target_chap
[ "$chappas" = clearchap ] && chapuser=nochap && chappas=nochap
targetcli saveconfig

# 5. check what LIO has now: the ACLs that map this LUN are exactly the requested initiators, and the portal is there
tree=`tpgtree $T`
have=`echo "$tree" | awk -v b="$diskids" '$1=="M" && $4==b {print $2}' | sort -u | tr '\n' ' '`
need=`for i in $wanted; do echo $i; done | sort -u | tr '\n' ' '`
[ "$have" = "$need" ] || fail target_acls
echo "$tree" | awk -v p="$want" '$1=="P" && $2==p' | grep -q . || fail target_portal

# 6. the record: leader etcd (volumesinfo reads it) with a sync request, zfs properties, the volume file of the pool
/pace/etcdput.py $leaderip volumes/ISCSI/$myhost/$DG/$name $DG/$name/$ipaddr/$ipsubnet/$portalport/$initiators/$chapuser/$chappas/$active
stamp=`date +%s`
leader=`./etcdget.py $leaderip leader`
/pace/etcdput.py $leaderip sync/volumes/${DG}_$name/request volumes_$stamp
/pace/etcdput.py $leaderip sync/volumes/${DG}_$name/request/$leader volumes_$stamp
/sbin/zfs set ip:addr=$ipaddr $DG/$name
/sbin/zfs set ip:subnet=$ipsubnet $DG/$name
/sbin/zfs set ip:portalport=$portalport $DG/$name
/sbin/zfs set status:mount=$active $DG/$name
shortname=`echo ${name} | rev | cut -d_ -f2- | rev`
yes | cp shareiscsi.txt /TopStordata/iscsi.${name}
sed -i "s/Vtype/ISCSI/g"  /TopStordata/iscsi.${name}
sed -i "s/Rpool/$DG/g"  /TopStordata/iscsi.${name}
sed -i "s/Rname/$name/g"  /TopStordata/iscsi.${name}
sed -i "s/Ripadd/$ipaddr/g"  /TopStordata/iscsi.${name}
sed -i "s/Ripsub/$ipsubnet/g"  /TopStordata/iscsi.${name}
sed -i "s/SHORTNAME/$shortname/g"  /TopStordata/iscsi.${name}
sed -i "s/NAMEISCSI/$name/g"  /TopStordata/iscsi.${name}
sed -i "s/POOL/$DG/g" /TopStordata/iscsi.${name}
sed -i "s/IPADDRESS/$ipaddr/g" /TopStordata/iscsi.${name}
sed -i "s/IPSUBNET/$ipsubnet/g" /TopStordata/iscsi.${name}
sed -i "s/PORTALPORT/$portalport/g" /TopStordata/iscsi.${name}
sed -i "s/TARGETIQN/$initiators/g" /TopStordata/iscsi.${name}
sed -i "s/CHAPUSER/$chapuser/g" /TopStordata/iscsi.${name}
sed -i "s/CHAPPAS/$chappas/g" /TopStordata/iscsi.${name}
sed -i "s/ACTIVE/$active/g" /TopStordata/iscsi.${name}
yes | cp /TopStordata/iscsi.${name} /$DG/
/pace/putzpool.py
logmsg VolCsu01 info $userreq $name
echo ready ;
