#!/bin/sh
export ETCDCTL_API=3
cd /TopStor/
# QSD5.344: no CHAP secret in the debug copy (argument 10)
echo $@ | awk '{ if (NF >= 10) $10 = "****"; print }' > /root/volchange
# QSD5.344 (QC tests 650, 653): the arguments in the order fapi volumes/config sends them -- every slot used to be read
# one place off (the leader address first was not expected), so privthis.sh got the wrong user and every iSCSI change
# (initiators, port, CHAP) was ignored:
#   leaderip pool name quota ipaddr subnet portalport initiators chapuser chappas active user owner user
leaderip=`echo $@ | awk '{print $1}'`;
pDG=`echo $@ | awk '{print $2}'`;
name=`echo $@ | awk '{print $3}'`;
quota=`echo $@ | awk '{print $4}'`;
ipaddr=`echo $@ | awk '{print $5}'`;
ipsubnet=`echo $@ | awk '{print $6}'`;
portalport=`echo $@ | awk '{print $7}'`;
initiators=`echo $@ | awk '{print $8}'`;
chapuser=`echo $@ | awk '{print $9}'`;
chappas=`echo $@ | awk '{print $10}'`;
active=`echo $@ | awk '{print $11}'`;
userreq=` echo $@ | awk '{print $12}'`;
DG=`echo $pDG `;
privilege="ISCSI";
contrun=`./privthis.sh $privilege $userreq`;
if [[ $contrun == 'true' ]]
then
 docker exec etcdclient /TopStor/logmsg.py VolCst01 info $userreq $name
 echo name=$name
 # the node name of the volume record, as VolumeCreateISCSI writes it
 myhost=`docker exec etcdclient /TopStor/etcdgetlocal.py clusternode`
 older=`ETCDCTL_API=3 /pace/etcdgetlocal.py volumes $name `
 echo /pace/etcdput.py $leaderip volumes/ISCSI/$myhost/$DG/$name $DG/$name/$ipaddr/$ipsubnet/$portalport/$initiators/$chapuser/$chappas/$active
 /pace/etcdput.py $leaderip volumes/ISCSI/$myhost/$DG/$name $DG/$name/$ipaddr/$ipsubnet/$portalport/$initiators/$chapuser/$chappas/$active
  stamp=`date +%s`
  leader=`docker exec etcdclient /TopStor/etcdgetlocal.py leader`
  ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/volumes/${DG}_$name/request volumes_$stamp
  ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/volumes/${DG}_$name/request/$leader volumes_$stamp
 #/pace/broadcasttolocal.py volumes/ISCSI/$myhost/$DG/$name $DG/$name/$ipaddr/$ipsubnet/$portalport/$initiators/$chapuser/$chappas/$active
 oldipaddr=`zfs get -H ip:addr $DG/$name | awk '{print $3}'`
 echo got ip $ipaddr
 oldipsubnet=`zfs get -H ip:subnet $DG/$name | awk '{print $3}'`
 sed -i "s/$oldipaddr/$ipaddr/g" /$DG/iscsi.$name
 sed -i "s/$oldipsubnet/$ipsubnet/g" /$DG/iscsi.$name
 /sbin/zfs set ip:addr=$ipaddr $DG/$name
 /sbin/zfs set ip:subnet=$ipsubnet $DG/$name
 /sbin/zfs set ip:portalport=$portalport $DG/$name
 /sbin/zfs set status:mount=$active $DG/$name
#pdhcp2524812990 pool1is 3G 10.11.11.11 24 3263 iqn.1991-05.com.microsoft:desktop-jckvhk3 MoatazNegm MezoAdmin admin dhcp19503 admin
 yes | cp shareiscsi.txt /TopStordata/iscsi.${name}
 shortname=`echo ${name} | rev | cut -d_ -f2- | rev`
 sed -i "s/Vtype/ISCSI/g"  /TopStordata/iscsi.${name}
 sed -i "s/Rpool/$DG/g"  /TopStordata/iscsi.${name}
 sed -i "s/Rname/$name/g"  /TopStordata/iscsi.${name}
 sed -i "s/Ripadd/$ipaddr/g"  /TopStordata/iscsi.${name}
 sed -i "s/Ripsub/$ipsubnet/g"  /TopStordata/iscsi.${name}
 sed -i "s/SHORTNAME/$shortname/g"  /TopStordata/iscsi.${name}
 sed -i "s/NAMECIFS/$name/g"  /TopStordata/iscsi.${name}
 sed -i "s/POOL/$DG/g" /TopStordata/iscsi.${name}
 sed -i "s/IPADDRESS/$ipaddr/g" /TopStordata/iscsi.${name}
 sed -i "s/IPSUBNET/$ipsubnet/g" /TopStordata/iscsi.${name}
 sed -i "s/PORTALPORT/$portalport/g" /TopStordata/iscsi.${name}
 sed -i "s/TARGETIQN/$initiators/g" /TopStordata/iscsi.${name}
 sed -i "s/CHAPUSER/$chapuser/g" /TopStordata/iscsi.${name}
 sed -i "s/CHAPPAS/$chappas/g" /TopStordata/iscsi.${name}
 sed -i "s/ACTIVE/$active/g" /TopStordata/iscsi.${name}
 yes | cp /TopStordata/iscsi.${name} /$DG/
 # QSD5.344 (validator L6): an address change puts the new address on cmynode before the portal is made on it (as
 # iscsi.sh does when the pool is imported); the old address and its target go below, once no LUN is left on them
 if [ -n "$oldipaddr" ] && [ "$oldipaddr" != '-' ] && [ "$oldipaddr" != "$ipaddr" ]; then
  /TopStor/cmynodeaddr.sh add $ipaddr $ipsubnet    # QSD5.352 (QC 698): locked, checked, retried
 fi
 /pace/delzfsvolumetarget $DG $name $userreq
 for i in $(echo $initiators | sed "s/,/ /g")
 do
#pdhcp2524812990 pool1is_250024055 10.11.11.11 3263 iqn.1991-05.com.microsoft:desktop-jckvhk3 MoatazNegm MezoAdmin
  echo /pace/addzfsvolumeastarget.sh $DG $name $ipaddr $portalport $i $chapuser '****'
  /pace/addzfsvolumeastarget.sh $DG $name $ipaddr $portalport $i $chapuser $chappas 
  
    # call your procedure/other scripts here below
 done
 # QSD5.344 (validator L6): an initiator taken off the list kept its ACL (with its CHAP user, so the target kept asking
 # for CHAP).  On the new and the old address: an ACL without a mapped LUN is deleted, authentication is off when no ACL
 # has a CHAP user left; the old address with no LUN left loses its target and leaves cmynode (as VolumeDeleteISCSI).
 for addr in `echo $ipaddr $oldipaddr | tr ' ' '\n' | grep '\.' | sort -u`
 do
  ipdom=`echo $addr | sed 's/\.//g'`
  tiqn=iqn.2016-03.com.$ipdom:data
  cfsacls=/sys/kernel/config/target/iscsi/$tiqn/tpgt_1/acls
  if [ -d $cfsacls ]; then
   for acl in `ls $cfsacls`
   do
    ls -d $cfsacls/$acl/lun_* >/dev/null 2>&1 || targetcli iscsi/$tiqn/tpg1/acls delete $acl
   done
   chapacls=`cat $cfsacls/*/auth/userid 2>/dev/null | grep -v '^NULL$' | grep -c .`
   [ "$chapacls" -eq 0 ] && targetcli iscsi/$tiqn/tpg1 set attribute authentication=0
  fi
  if [ "$addr" != "$ipaddr" ] && targetcli ls iscsi/ 2>/dev/null | grep -q "$tiqn" \
     && ! targetcli ls /iscsi/$tiqn/tpg1/luns 2>/dev/null | grep -q 'o- lun[0-9]'; then
   targetcli /iscsi delete $tiqn
   exec 9>>/TopStordata/cmynode.lock; flock -w 120 9   # QSD5.352: cmynode changes one at a time (cmynodeaddr.sh)
   nmcli conn mod cmynode -ipv4.addresses ${addr}/${oldipsubnet:-24}
   nmcli conn up cmynode
   flock -u 9
  fi
 done
 targetcli saveconfig
 /pace/putzpool.py 
 docker exec etcdclient /TopStor/logmsg.py VolCsu01 info $userreq $name
 echo ready ;
fi
