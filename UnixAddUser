#!/bin/bash
# QSD5.337: user/group scripts run one at a time (several Add User clicks in a row ran useradd/userdel in parallel and lost users);
# a nested call (UnixChangeGroup -> UnixChangeUser, UnixAddUser -> ...) inherits TS_USRLOCK and does not lock again
if [ -z "$TS_USRLOCK" ] && command -v flock >/dev/null 2>&1; then export TS_USRLOCK=1; exec flock -w 900 /tmp/topstor-users.lock "$0" "$@"; fi
# QSD5.344: the debug copy of the arguments has the password (argument 5) masked (QC test 701)
echo $@ | awk '{ if (NF >= 5) $5 = "****"; print }' > /root/unixadduser
export ETCDCTL_API=3
cd /TopStor
leaderip=`echo $@  | awk '{print $1}'`;
username=`echo $@ | awk '{print $2}'`;
homePool=`echo $@ | awk '{print $3}'`;
usergroups=`echo $@ | awk  '{print $4}'`;
grps=`echo $grpusers | sed 's/groups//g' | sed 's/\,/ /g'`
userpass=`echo $@ | awk '{print $5}'`;
size=`echo $@ | awk '{print $6}'`;
HomeAddr=`echo $@  | awk '{print $7}' `;
HomeSubnet=`echo $@  | awk '{print $8}'`;
pullsync=`echo $@  | awk '{print $9}'`;
# QSD5.352 r9 (prover D2): fapi users/UnixAddUser adds homeowner=<host of the home pool's owner> (a key=value word at the
# end, after the positional arguments)
homeowner=`echo "$@" | grep -o 'homeowner=[^ ]*' | head -n 1 | cut -d= -f2`
homeremote=0
echo $pullsync | grep pull
if [ $? -eq 0 ]
then
	userid=`echo $@  | awk '{print $10}'`;
	usergd=`echo $@  | awk '{print $11}'`;
	active=`echo $@  | awk '{print $12}'`;
	permis=`echo $@  | awk '{print $13}'`;
	userpass=`/TopStor/decthis.sh $username $userpass | awk -F'_result' '{print $2}'`
	userreq=`echo $@  | awk '{print $14}'`;
else
	userreq=`echo $@  | awk '{print $10}'`;
fi
# Guards for a NEW user (not for the sync copy another node makes of an accepted user): the rules of
# uservalid.py, and never a name that is a system account here -- "userdel -f" below would delete it.
echo $pullsync | grep -q pull
if [ $? -ne 0 ]
then
	why=`/TopStor/uservalid.py "$username" "$userpass"`
	if [ $? -ne 0 ]
	then
		echo UnixAddUser: user "$username" rejected: $why
		docker exec etcdclient /TopStor/logmsg.py `echo "$why" | cut -d'|' -f1` error $userreq `echo "$username" | cut -c1-32 | tr -c 'A-Za-z0-9.\n-' '.'`
		exit 1
	fi
	sysline=`getent passwd "$username"`
	if [ -n "$sysline" ]
	then
		echo "$sysline" | awk -F':' '{print $5}' | grep -q '^TopStor'
		if [ $? -ne 0 ]
		then
			echo UnixAddUser: user "$username" rejected: it is a system account on this node
			docker exec etcdclient /TopStor/logmsg.py Unlin1027rs error $userreq $username
			exit 1
		fi
	fi
fi
privilege="Box_Users";
contrun=`./privthis.sh $privilege $userreq`;
echo contrun $contrun, $userreq
if [[ $contrun == 'true' ]]
then

	myhost=`docker exec etcdclient /TopStor/etcdgetlocal.py clusternode`
	myhostip=`docker exec etcdclient /TopStor/etcdgetlocal.py clusternodeip`
	leader=`docker exec etcdclient /TopStor/etcdgetlocal.py leader`
	docker exec etcdclient /TopStor/logqueue.py `basename "$0"` running $userreq
	echo $leader | grep $myhost
	if [ $? -ne 0 ];
	then
 		etcd=$myhostip
	else
 		etcd=$leaderip
		echo $pullsync | grep pullsync
		if [ $? -ne 0 ]
		then
 
 			/pace/etcdget.py $etcd volumes --prefix | grep -E "(^|[^A-Za-z0-9_])${username}(_[0-9]+)?([^A-Za-z0-9_]|$)"
	 		if [ $? -eq 0 ];
 			then
 				docker exec etcdclient /TopStor/logmsg.py Unlin1021uv warning $userreq $username
  				docker exec etcdclient /TopStor/logqueue.py `basename "$0"` finish $userreq 
  				exit
 			fi
		
 			./etcdget.py $etcd user --prefix | grep -w $username 
 			if [ $? -eq 0 ];
 			then
  				docker exec etcdclient /TopStor/logmsg.py Unlin1021uu warning $userreq $username
  				docker exec etcdclient /TopStor/logqueue.py `basename "$0"` finish $userreq 
  				exit
 			fi
		fi
	fi

 echo $pullsync | grep pull
 if [ $? -ne 0 ]
 then
	 docker exec etcdclient /TopStor/logmsg.py Unlin1018 info $userreq $username
 else
 	docker exec etcdclient /TopStor/logmsg.py Unlin1005 info $userreq $username
 fi
 userdel -f  $username
 #pas=`echo $userpass | openssl enc -e -base64 -aes-256-ctr -nopad -nosalt -k '#skMe22'$username`
 pas=`/TopStor/encthis.sh $username $userpass | awk -F'_result' '{print $2}'` 
 homebase='-b /NoHome -M'
 groupdel $username
 echo $homePool | grep 'NoHome'
 if [ $? -ne 0 ];
 then
  	homedir=$homePool
  	homebase='-b /'$homedir' -M'  
 else
 	echo $pullsync | grep pull
 	if [ $? -ne 0 ]
	then
  		docker exec etcdclient /TopStor/logmsg.py Unlin1023 warning $userreq $username
	fi
 fi
 echo iiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiii
 # QSD5.347: the shadow password field is '!' (no unix password).  'useradd -p' takes an ENCRYPTED value; it got the clear
 # password, so /etc/shadow of every node (bind-mounted into the share containers) held it in clear text.  Nothing logs in
 # with it: the shell is nologin, the API checks usershash/<user>, samba has its own password database (smbuserfix.sh,
 # smbpasswd), and crypt() of a typed password never equalled a clear-text field, so the field never worked as a password.
 shadowpw='!'
 echo $pullsync | grep pull
 if [ $? -eq 0 ]
 then
	useradd -c"TopStor"$pas  $homebase -u $userid -p "$shadowpw" -s /usr/sbin/nologin $username
	groupmod -g $usergd $username
	echo useradd \-c"TopStor"$pas $homebase \-g $usergd \-u $userid \-p "$shadowpw" \-s /usr/sbin/nologin $username
	
 else
	echo useradd \-c"TopStor"$pas $homebase \-p "$shadowpw" \-s /usr/sbin/nologin $username
 	useradd -c"TopStor"$pas $homebase -p "$shadowpw" -s /usr/sbin/nologin $username 
 fi
 echo $pullsync | grep pull
 if [ $? -ne 0 ]
 then
 	echo $homePool | grep 'NoHome'
 	if [ $? -ne 0 ];
 	then
		docker exec etcdclient docker exec etcdclient /TopStor/logmsg.py Unlin1024 info  $userreq $username $homedir
  		echo hhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhh
		# QSD5.352 r9 (prover D2): the home was always created HERE (the leader), also on a pool owned by another node:
		# HOMEE-<ip> ran on the leader, the dataset was mounted in the leader's mount namespace and the registry record
		# named the leader, so a later change or delete on the real owner found a busy dataset (NFS1001) and a stale
		# container.  A pool of another node: the home is created by that node (posted below, after the user exists and
		# its hash is stored); a pool of this node (or no owner given): here, as before.
		if [ -n "$homeowner" ] && [ "$homeowner" != "$myhost" ]; then
			homeremote=1
		else
  		echo /TopStor/VolumeCreateHOME $leaderip $homePool $username $size $username $HomeAddr $HomeSubnet active $userreq $myhost $userreq 
  		/TopStor/VolumeCreateHOME $leaderip $homePool $username $size $username $HomeAddr $HomeSubnet active $userreq $myhost $userreq 
		fi
  		echo hhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhh
	fi
 fi

 # the leader does not run UnixAddUser_sync, which is what copies this script; the share containers read it from /hostetc
 cp -f /TopStor/smbuserfix.sh /etc/smbuserfix.sh
 currentcifs=`docker ps | awk '{print $NF}' | grep CIFS | grep -v 'CIFS_'`
 echo "$currentcifs" | while read y
 do
 	echo $y | grep CIFS
 	if [ $? -eq 0 ]
 	then
       		echo dock=$y
       		echo docker exec $y  sh /hostetc/smbuserfix.sh x $username $pas 
       		docker exec $y  sh /hostetc/smbuserfix.sh x $username $pas
 	fi	
 done

# echo $pullsync | grep sync 
# if [ $? -ne 0 ]
# then
# 	currentcifs=`docker ps | egrep 'CIFS|HOM' | awk '{print $1}' | grep -v 'CIFS_'`
# 	echo "$currentcifs" | while read y; do docker exec $y  sh /hostetc/smbuserfix.sh x $username $userpass;  done; 
# fi
 docker exec intsmb /root/smbuser.sh $username $userpass
 userline=`getent passwd "$username"`     # QSD5.345: this name only (grep took qu10's line for qu1, see UnixAddGroup)
 if [ $? -ne  0  ]; then
 	echo $pullsync | grep pull
 	if [ $? -ne 0 ]
	then
  		docker exec etcdclient /TopStor/logmsg.py Unlin1020 error $userreq $username
	fi
 else 
 # openssl rsautl -encrypt -inkey key/public_key.pem -pubin -in <( echo $userpass) -out key/$username;  
  userid=`echo $userline | awk -F':' '{print $3}'`
  usergd=`echo $userline | awk -F':' '{print $4}'`
  userhome=`echo $userline | awk -F':' '{print $6}'`
  #userhash=`echo $userline | awk -F':' '{print $5}' | awk -F'TopStor' '{print $2}'`
  userhash=$pas
  
  /TopStor/etcdput.py $etcd 'usersinfo/'$username $userid':'$usergd':/'$homePool'/'$username'/'$size'/no/no/no/no/no/no/no/no/no/no/no/no/no/no/no/no/no/no/no/no/no/no/no/no/no/no/no/no/no'
  /TopStor/etcdput.py $etcd 'usershash/'$username $userhash
  #/TopStor/broadcast.py UserAdd /TopStor/pump.sh UnixAddUser_sync -d$myhost $username $userhash $userid $usergd $userhome
  echo $etcd 2222222222222222222222222222222222222222222222222222222222222222 
   /TopStor/UnixChangeUser $leaderip $username $usergroups $userreq create $pullsync
  echo $etcd 2222222222222222222222222222222222222222222222222222222222222222 
  echo s$pullsync | grep pull
  if [ $? -ne 0 ]
  then
  	docker exec etcdclient /TopStor/logmsg.py Unlin1022 info $userreq $username
  fi
 fi 
 echo hi1
 echo myhost=$myhost    leader=$leader
 echo $leader | grep $myhost
 if [ $? -eq 0 ];
 then
	echo hi2
	stamp=`date +%s%N`
	myscript=`basename "$0"`
	# QSD5.347: the request name is a copy of the arguments; argument 5 (the password, field 6 after the script name) is
	# replaced by 'pwhidden'.  The key sync/user/<params>/request sat in the etcd of every node with the clear password
	# in it; the followers read only the user name from it (checksyncs.py oneusersync, opers[2]) and take the hash from
	# usershash/<user>.
	params=`echo $myscript $@ $stamp | awk '{ if (NF >= 6) $6 = "pwhidden"; print }' | sed 's\ \\_\g'`
	/pace/etcddel.py $leaderip sync/user _${username}_
	/pace/etcdput.py $leaderip sync/user/$params/request/$myhost user_${username}_$stamp
	/pace/etcdput.py $leaderip sync/user/$params/request user_${username}_$stamp
	# the UsrChange request of this user (its groups) is filed by the UnixChangeUser call above, with the arguments of UnixChangeUser;
	# the copy that used to be filed here carried the arguments of UnixAddUser ($@), so followers ran UnixChangeUser with
	# 'NoHome' as the groups and 'groups...' as the requester
 fi
 # r9 (prover D2): the home on another node's pool, posted to that node (as fapi volumes/create posts to the pool owner).
 # VolumeCreateHOME there waits until the user sync has created the user (fromadduser=1).  Owner address unknown: here.
 if [ $homeremote -eq 1 ] && [ -n "$userline" ]; then
	ownerip=`/pace/etcdget.py $leaderip ready/$homeowner 2>/dev/null`
	if echo "$ownerip" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'; then
		msg="{'req': 'Pumpthis', 'reply': ['/TopStor/VolumeCreateHOME', '$leaderip', '$homePool', '$username', '$size', '$username', '$HomeAddr', '$HomeSubnet', 'active', '$userreq', '$homeowner', '$userreq', 'fromadduser=1']}"
		docker exec etcdclient /TopStor/sendhost.py $ownerip "$msg" recvreply $myhost
		echo "home of $username on $homePool posted to the pool owner $homeowner ($ownerip)" >> /root/unixadduser
	else
		echo "home of $username on $homePool: owner $homeowner has no address, created here" >> /root/unixadduser
		/TopStor/VolumeCreateHOME $leaderip $homePool $username $size $username $HomeAddr $HomeSubnet active $userreq $myhost $userreq
	fi
 fi
 echo hi3
 docker exec etcdclient /TopStor/logqueue.py `basename "$0"` finish $userreq 
fi
