#!/bin/sh
echo $@ > /root/delusersync
export ETCDCTL_API=3
cd /TopStor
web="/var/www/html/des20/Data/Usersstatus.log";
logging="/var/www/html/des20/Data/currentinfo2.log";
myhost=`hostname -s`
glog='/var/www/html/des20/Data/TopStor.log'
username=`echo $@ | awk '{print $1}'`;
userreq=`echo $@ | awk '{print $2}'`;
# QSD5.350: exact names ('echo NoUser | grep $username' / 'echo admin | grep $username' were substring tests the other way
# round: the users User, Use, dmin, admi ... were never synced away; an empty name is not a user)
if [ -z "$username" ] || [ "$username" = NoUser ] || [ "$username" = admin ];
then
 exit
fi


privilege="Box_Users";
contrun=`./privthis.sh $privilege $userreq`;
myip=`/sbin/pcs resource show CC | grep Attrib | awk -F'ip=' '{print $2}' | awk '{print $1}'`
if [[ $contrun == 'true' ]]
then
/TopStor/UnixDelUserlocal $username $userreq
fi
# QSD5.350: the exact account name (a substring grep found 'dmin' in the line of admin and kept the users key)
cut -d: -f1 /etc/passwd | grep -qxF -- "$username"
if [ $? -ne 0 ];
then
 /pace/etcddellocal.py $myip users /$username/ 
fi
