#!/bin/bash
export ETCDCTL_API=3
cd /TopStor
web='/usr/local/www/apache24/data/des19/Data/status.log';
logging='/usr/local/www/apache24/data/des19/Data/currentinfo2.log'
myhost=`hostname -s`
rm txt/cronthis.txt;
# QSD5.352 r9 (prover D3): the log rows go through etcdclient (the node's own logmsg.py cannot reach the message bus,
# so no Snap1043/1044/1045 row was ever written)
oper1=` echo $@ | awk '{print $1}'`;
userreq=` echo $@ | awk '{print $2}'`;
 docker exec etcdclient /TopStor/logmsg.py Snap1043 info $userreq $oper1
snapsched=`echo $oper1 | awk -F@ '{print $2}'`;
# QSD5.352 r8 (validator r7, point 4): 'cat txt/cronthis.txt | grep -v $snapsched > txt/cronthis.txt' truncated the file
# before cat read it (499 of 500 runs ended EMPTY) and the next line installed it: the whole crontab was wiped; an empty
# name (no '@' in the argument) did the same.  Filtered into a second file now (fixed string); no name or no crontab:
# nothing is installed.  No caller in TopStor, pace or topstorweb (the API uses SnapShotPeriodDelete).
[ -n "$snapsched" ] || { docker exec etcdclient /TopStor/logmsg.py Snap1044 error $userreq $oper1; exit 0; }
crontab -l > txt/cronthis.txt 2>/dev/null || exit 0
grep -vF -- "$snapsched" txt/cronthis.txt > txt/cronthis.new
crontab txt/cronthis.new 2>txt/${0:2}$userreq.txt;
err=`wc -c  txt/${0:2}$userreq.txt | awk '{print $1}'`;
if [[ $err -ge  4  ]]; then
 docker exec etcdclient /TopStor/logmsg.py Snap1044 error $userreq $oper1
else 
 docker exec etcdclient /TopStor/logmsg.py Snap1045 info $userreq $oper1
fi;
rm txt/${0:2}$userreq.txt
oldlog=`cat $logging | sed 's/]//g'`; newlog=$oldlog,$logthis]; echo $newlog > $logging;
 /pace/putzpool.py
