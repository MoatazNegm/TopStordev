 git checkout $whyreboot
 echo shuttingdown 8_QS >> /root/HostCC2
fi
echo $whyreboot | grep reset 
if [ $? -eq 0 ];
then
 users=`cat /etc/passwd | grep TopStor | grep -v Everyone | awk -F':' '{print $1}'`
 systemctl stop etcd
 rm -rf /var/lib/etcd/member/*
fi
pkill httpd
echo shuttingdown 10 >> /root/HostCC2
sync
sync
sync
/sbin/zpool export -a &
echo shuttingdown 11 >> /root/HostCC2
#pkill zfsping
echo finish > /TopStordata/rebootstatus
# --- SIGNAL REBOOT VIA etcd ---
# Do NOT call /sbin/reboot directly: in this privileged container that
# would call the host kernel's reboot(2) syscall and reboot the entire
# host machine. Instead, write the etcd key that the running
# rebootmepls.sh watcher is polling. The watcher will reset state and
# trigger /TopStor/docker_setup.sh reboot, which ends in
# /TopStor/reboot.sh — a container-safe power-cycle analog. All the
# cleanup above (docker stop, iscsi logout, zpool export, httpd kill,
# targetcli cleanup) still runs synchronously — only the final
# hard-reset is delegated to the watcher.
reboot_reason='pls_fromrebootme'
reboot_written=0
for etcd_ip in "$hostip" "$myhostip" "127.0.0.1"; do
    if [ -n "$etcd_ip" ] && /TopStor/etcdput.py "$etcd_ip" rebootme/$myhost $reboot_reason 2>/dev/null; then
        echo "[rebootme] signaled reboot via etcd at $etcd_ip"
        reboot_written=1
        break
    fi
done
if [ "$reboot_written" -ne 1 ]; then
    echo "[rebootme] WARNING: failed to signal reboot to etcd (any endpoint)"
fi
exit 0
