#!/bin/sh
cd /TopStor
export ETCDCTL_API=3
web="/var/www/html/des20/Data/Usersstatus.log";
logging="/var/www/html/des20/Data/currentinfo2.log";
txtres='/TopStordata/'`basename $0`'.txt'
rm -rf $txtres &>/dev/null
myhost=`hostname -s`
glog='/var/www/html/des20/Data/TopStor.log'
username=`echo $@ | awk '{print $1}'`;
userreq=`echo $@ | awk '{print $2}'`;
# QSD5.345: exact name (any group whose name is part of 'Everyone' -- one, very, e ... -- was never deleted here)
if [ "$username" = "Everyone" ];
then
 exit
fi


privilege="Box_Users";
contrun=`./privthis.sh $privilege $userreq`;
if [[ $contrun == 'true' ]]
then
  /TopStor/logmsg.py Unlin11044 info $userreq $username
#rm -rf /home/$username &>/dev/null
userdel -f  $username 
cut -d: -f1 /etc/passwd | grep -qxF -- "$username"     # QSD5.345: exact name, as UnixDelGroup
if [ $? -eq 0 ]; then
  /TopStor/logmsg.py Unlin1g10011 error $userreq $myhost
else
  /TopStor/logmsg.py Unlin11100 info $userreq $username
  /TopStor/UnixDelGroupAcl $username
  groupdel $username
fi;
fi
