#!/bin/sh
cd /TopStor
echo $@ > ~/`basename "$0"`
datenow=`date +%m/%d/%Y`; timenow=`date +%T`;
volname=`echo $@ | awk '{print $3}'`;
leaderip=`echo $@ | awk '{print $1}'`;
pDG=`echo $@ | awk '{print $2}'`;
pro=`echo $@ | awk '{print $4}'`;
userreq=` echo $@ | awk '{print $5}'`;
DG=$pDG; name=$volname;   # the dataset of the volume (it was the text "pDG/" - the address and type lookups below found nothing, the share container kept the dataset busy)
privilege=$pro;
contrun=`./privthis.sh $privilege $userreq`;
if [[ $contrun == 'true' ]]
then
        myhost=`docker exec etcdclient /TopStor/etcdgetlocal.py clusternode`
        myhostip=`docker exec etcdclient /TopStor/etcdgetlocal.py clusternodeip`
        leader=`docker exec etcdclient /TopStor/etcdgetlocal.py leader`
        echo $leader | grep $myhost
        if [ $? -ne 0 ];
        then
                echo hihih
                etcd=$myhostip
        else
                echo nono
                etcd=$leaderip
        fi
 echo etcd=$etcd
 docker exec etcdclient /TopStor/logmsg.py NFS1000 info $userreq $volname
 docker exec etcdclient /TopStor/logqueue.py `basename "$0"` running $userreq
 # QSD5.329: right after a take over the registry did not answer for a while: ip and type came back empty, cifsremove.sh removed
 # no registry record and the stale record kept the address blocked (a new home on it never came up). Ask again.
 # QSD5.352 r9 (prover D5): the record is read from the LEADER: a follower's own copy still had the OLD address for a few
 # seconds after a home change, cifsremove.sh then removed the old-address container and left HOMEE-<new ip> holding the
 # dataset (NFS1001)
 for try in 1 2 3 4 5 6 7 8; do
  [ -n "`/TopStor/etcdget.py $leaderip volume $volname | grep administrator`" ] && break
  sleep 5
 done
 ipaddr=`/TopStor/etcdget.py $leaderip volume $volname | awk -F'administrator' '{ print $2}' | awk -F'/' '{print $3}'`
 vtype=`/TopStor/etcdget.py $leaderip volume $volname | awk -F'/' '{print $2}'`
 echo ip=$ipaddr
 stamp=`date +%s`
 ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/volumes/${pDG}_$name/request volumes_$stamp
 ETCDCTL_API=3 /pace/etcdput.py $leaderip sync/volumes/${pDG}_$name/request/$leader volumes_$stamp
 /TopStor/cifsremove.sh $leaderip $pDG $volname $ipaddr $vtype 2>/root/errcifsremove
 # QSD5.352 r9 (validator r8 R1): no SnapShotPeriodDelete call here any more: snapperioddel.sh + crondelete (in the remove
 # script above) delete this volume's records, call keys and lines, anchored on /<pool>/<volume>/; its substring match took
 # the records and lines of every volume whose full name contains this one (vol_123, xvol_12 when vol_12 goes).
 echo /sbin/zfs destroy -rf $pDG/$volname
 # QSD5.352 r9 (prover D6): a share container of this node that still mounts the dataset (the other home of a shared
 # address started again in between, an old-address container) made the destroy fail at once (NFS1001): such a container
 # is removed (volbusyfree.sh, the other shares of the address are started again without this volume) and the destroy
 # is tried again, up to 12 times, 5 s apart (a share start still running, cifs.py tries up to 5 x 8 s).
 destroyrc=1
 for try in `seq 1 12`; do
  /sbin/zfs unmount -f $pDG/$volname 2>/dev/null
  /sbin/zfs destroy -rf $pDG/$volname && { destroyrc=0; break; }
  echo "`date +%T` destroy of $pDG/$volname failed (try $try)" >> /root/volbusyfree
  [ $try -eq 12 ] && break
  /TopStor/volbusyfree.sh $leader $leaderip $myhost $myhostip $pDG $volname
  sleep 5
 done
 if [ $destroyrc -ne 0  ]; then
   docker exec etcdclient /TopStor/logmsg.py NFS1001 error $userreq $volname
   echo /sbin/zfs destroy -rf $pDG/$volname >/root/errorVolumeDeleteHOME
   docker exec etcdclient /TopStor/logqueue.py `basename "$0"` stop $userreq
   exit
 fi
 rm -rf $pDG/$volname
 echo rm -rf $pDG/$volname
 # the registry record goes with the dataset (cifsremove.sh does it too, but with no answer from etcd it silently did not)
 for try in 1 2 3 4 5 6; do
  /TopStor/etcddel.py $leaderip vol $volname
  [ -z "`/TopStor/etcdget.py $leaderip volume $volname | grep administrator`" ] && break
  sleep 5
 done
 # QSD5.352 r9 (prover D4): a home created for a name that is no user (volumes/create type=HOME) left usersinfo/<name> =
 # '_1///<size>' (VolumeCreateHOME rewrote the '_1' of a missing key); the name stayed blocked after the delete.  A
 # usersinfo value that is no user record (uid:gid:...) goes with the home; a real user's record is kept.
 short=`echo $volname | rev | cut -d_ -f2- | rev`
 uinfo=`/pace/etcdget.py $leaderip usersinfo/$short 2>/dev/null`
 if [ -n "$short" ] && [ -n "$uinfo" ] && [ "$uinfo" != '_1' ] && ! echo "$uinfo" | grep -Eq '^[0-9]+:[0-9]+:'; then
  /pace/etcddel.py $leaderip usersinfo/$short
  echo "usersinfo/$short ($uinfo) removed with the home $pDG/$volname" >> /root/volumedeletehome
 fi
 docker exec etcdclient /TopStor/logmsg.py NFS1002 info $userreq $pDG/$volname
 docker exec etcdclient /TopStor/logqueue.py `basename "$0"` stop $userreq
fi
 docker exec etcdclient /TopStor/etcdputlocal.py dirty/volume 0
 docker exec etcdclient /TopStor/logqueue.py `basename "$0"` stop $userreq
