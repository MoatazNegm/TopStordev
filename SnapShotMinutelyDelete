#!/bin/bash
cd /TopStor
web='/usr/local/www/apache24/data/des19/Data/status.log';
echo Deleteing Snapshot schedule.... > $web;
rm txt/err.txt;
rm txt/cronthis.txt;
snapsched=`echo $@ | awk -F@ '{print $2}'`;
# QSD5.352 r8 (validator r7, point 4): 'cat txt/cronthis.txt | grep -v $snapsched > txt/cronthis.txt' truncated the file
# before cat read it (499 of 500 runs ended EMPTY) and the next line installed it: the whole crontab was wiped; an empty
# name (no '@' in the argument) did the same.  Filtered into a second file now (fixed string); no name or no crontab:
# nothing is installed.  No caller in TopStor, pace or topstorweb (the API uses SnapShotPeriodDelete).
[ -n "$snapsched" ] || exit 0
crontab -l > txt/cronthis.txt 2>/dev/null || exit 0
grep -vF -- "$snapsched" txt/cronthis.txt > txt/cronthis.new
crontab txt/cronthis.new 2>txt/err.txt;
err=`wc -c  txt/err.txt | awk '{print $1}'`;
if [[ $err >  4  ]]; then
	cat txt/err.txt > $web;
else 
 echo DONE...Snapshot $snapsched is deleted > $web; 
fi;
sleep 2;
./GetPoolMinutelylist
